# Kopiere diese Datei zu ".env" und trag deine Keys aus dem Spotify-Dashboard ein:
# https://developer.spotify.com/dashboard  →  deine App  →  Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Land für die Diskografie (weniger Duplikate, nur in diesem Land verfügbare Releases).
# Leer lassen = alle Länder.
SPOTIFY_MARKET=DE

# Port des Servers (Hosting-Anbieter wie Render setzen ihn automatisch)
PORT=3001

# Auf 1 setzen, um mit Demo-Daten statt Spotify zu spielen (passiert auch automatisch ohne Keys)
DEMO=0
